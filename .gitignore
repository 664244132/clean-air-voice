# ==============================================================================
# Git Exclusion Rules (.gitignore)
# ป้องกันการบันทึก Dependency, ไฟล์ความลับ และไฟล์ส่วนตัวขึ้น Git Repository
# ==============================================================================

# Dependencies
node_modules/

# Environment Variables & API Keys (ความลับสำคัญ - ห้ามคอมมิตเด็ดขาด)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# Large Media Files (ไฟล์สื่อวิดีโอขนาดใหญ่)
public/*.mp4
public/*.webm
public/*.mkv

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS Generated Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# IDE & Editor Settings
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
